<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Down alert: runs `ring-router watchdog` every 5 minutes.
     Install:
       cp launchd/local.ring-router.watchdog.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.ring-router.watchdog.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.ring-router.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dave/claude-mac-mini/ring-router/build/Ring Router.app/Contents/MacOS/RingRouter</string>
        <string>/Users/dave/claude-mac-mini/ring-router/.venv/bin/ring-router</string>
        <string>watchdog</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/dave/claude-mac-mini/ring-router</string>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/dave/Library/Logs/ring-router-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dave/Library/Logs/ring-router-watchdog.log</string>
</dict>
</plist>
