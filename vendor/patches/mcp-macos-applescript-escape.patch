+/**
+ * Escapes a string for an AppleScript string literal. AppleScript knows only \\ \" \n \t \r;
+ * the JXA escaper's \' \` \$ are syntax errors there (any apostrophe broke sends).
+ */
+function sanitizeForAppleScript(input) {
+    return input
+        .replace(/\\/g, '\\\\')
+        .replace(/"/g, '\\"')
+        .replace(/\r\n?/g, '\n')
+        .replace(/\0/g, '');
+}
